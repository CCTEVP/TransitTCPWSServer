# ZeroMQ endpoint from GOVI/NDOV specs
ZMQ_ENDPOINT=tcp://pubsub.besteffort.ndovloket.nl:7658

# Comma-separated topic prefixes (envelopes)
# Example: /RIG/KV15messages,/RIG/KV17cvlinfo,/RIG/KV6posinfo
ZMQ_TOPICS=/RIG/KV15messages,/RIG/KV17cvlinfo,/RIG/KV6posinfo

# Prefix used for Rotterdam-specific command derivation
ROTTERDAM_TOPIC_PREFIX=/RIG/

# HTTP/WebSocket port for browser clients
PORT=8080

# Optional max payload bytes sent to clients (to avoid oversized frames)
MAX_PAYLOAD_BYTES=200000
