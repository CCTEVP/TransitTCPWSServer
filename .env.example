# HTTP/WebSocket port for browser clients
PORT=8080

# BISON feed (KV6/KV17) - realtime vehicle positions and mutations
ZMQ_ENDPOINT=tcp://pubsub.besteffort.ndovloket.nl:7658
ZMQ_TOPICS=/RIG/KV17cvlinfo,/RIG/KV6posinfo

# KV78Turbo feed - ExpectedArrivalTime forecasts (ARRIVING when ETA <= 15s)
ZMQ_TURBO_ENABLED=true
ZMQ_TURBO_ENDPOINT=tcp://pubsub.besteffort.ndovloket.nl:7817
ZMQ_TURBO_TOPICS=/GOVI/KV8passtimes/RET
# Subscribe only while stop is active; unsubscribe after idle
ZMQ_TURBO_ON_DEMAND=true
ZMQ_TURBO_IDLE_UNSUBSCRIBE_MS=60000

# Fire ARRIVING/ARRIVED this many seconds before true GOVI ETA (dashboard ETA unchanged)
COMMAND_ETA_OFFSET_SEC=10

# Rotterdam-specific command derivation
ROTTERDAM_TOPIC_PREFIX=/RIG/

# Filter: RIG/BISON stops (comma-separated, empty = all)
USERSTOPCODES=HA1161,HA1162,HA1141,HA1142

# Filter: GOVI/Turbo stops (empty/unset = reuse USERSTOPCODES)
GOVI_USERSTOPCODES=HA1161,HA1162,HA1141,HA1142

# Filter: LinePlanningNumber (comma-separated, empty = all). Wildcards: #=digit, *=any, ?=char
# Quote when using #: "1###" or "1###,43,44"
LINEPLANNINGNUMBERS="1###"

# Wall-clock times from NDOV (ExpectedArrivalTime etc.) are in this timezone
TRANSIT_TIMEZONE=Europe/Amsterdam

# Send RET_NO_TRAIN if no train info within this delay after startup (ms)
NO_TRAIN_INITIAL_DELAY_MS=30000

# Send RET_NO_TRAIN this long after departure if no new train arrives (ms)
NO_TRAIN_AFTER_DEPARTURE_MS=30000

# Drop oversized ZMQ payloads before processing (bytes)
MAX_PAYLOAD_BYTES=200000

# WebSocket keepalive ping interval (ms)
WS_PING_INTERVAL_MS=25000
